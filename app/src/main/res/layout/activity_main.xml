<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- Menu inferior PRIMEIRO (para usar layout_above) -->
        <LinearLayout
            android:id="@+id/bottomMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.3" />

            <ImageView
                android:layout_width="65dp"
                android:layout_height="60dp"
                android:src="@drawable/home"
                app:tint="#6BBE4B" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="35dp"
                android:layout_height="50dp"
                android:src="@drawable/info"
                app:tint="#C0C0C0" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.3" />
        </LinearLayout>

        <!-- Área branca central - AGORA ACIMA DO MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomMenu"
            android:orientation="vertical"
            android:background="@color/white"
            android:gravity="center"
            android:padding="24dp">

            <!-- Ícone da planta -->
            <ImageView
                android:layout_width="250dp"
                android:layout_height="200dp"
                android:src="@drawable/logo"
                android:contentDescription="Ícone planta"
                android:layout_marginBottom="20dp" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/poppins"
                android:text="Faça o upload da imagem"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Texto de descrição -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analise sua planta agora mesmo e receba o diagnóstico. Basta enviar uma foto nítida da folha e descubra se há sinais de doença, pragas ou deficiências."
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:textColor="#777777"
                android:layout_marginBottom="32dp"/>

            <!-- Botão verde -->
            <Button
                android:id="@+id/btnSelectImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecionar imagem"
                android:fontFamily="@font/poppins"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6BBE4B"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="16sp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>