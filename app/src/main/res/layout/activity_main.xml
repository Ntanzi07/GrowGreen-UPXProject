<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <!-- Área branca central -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="20dp"
            android:background="@color/white"
            android:padding="24dp"
            android:gravity="center">

            <!-- Ícone da planta -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/logo"
                android:contentDescription="Ícone planta" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/poppins"
                android:text="Faça o upload da imagem"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Texto de descrição -->
            <TextView
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:text="Analise sua planta agora mesmo e receba o diagnóstico. Basta enviar uma foto nítida da folha e descubra se há sinais de doença, pragas ou deficiências."
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="#777777"
                android:layout_marginBottom="24dp"/>

            <!-- Botão verde -->
            <Button
                android:id="@+id/btnSelectImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecionar imagem"
                android:fontFamily="@font/poppins"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6BBE4B"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.3" />

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginRight="0dp"
                android:src="@drawable/home"
                app:tint="#6BBE4B" />
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <ImageView
                android:layout_width="40dp"
                android:layout_height="70dp"
                android:src="@drawable/info"
                app:tint="#6BBE4B" />
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.3" />
        </LinearLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>